{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "PRC Platform - Schema SEO Testing Environment",
		"description": "A WordPress Playground blueprint that mirrors the PRC Platform wp-env testing setup",
		"author": "pewresearch"
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "https://playground.wordpress.net/plugin-proxy.php?build-ref=trunk"
	},
	"features": {
		"networking": true
	},
	"constants": {
		"PRC_PLATFORM_TESTING_MODE": true,
		"PRC_PRIMARY_SITE_ID": 1,
		"DEFAULT_TECHNICAL_CONTACT": "srubenstein@pewresearch.org",
		"TAXONOMY_TECHNICAL_CONTACT": "srubenstein@pewresearch.org"
	},
	"siteOptions": {
		"blogname": "PRC Platform - Schema SEO Testing"
	},
	"login": true,
	"landingPage": "/wp-admin/",
	"steps": [
		{
			"step": "wp-cli",
			"command": "wp plugin activate prc-platform-core"
		},
		{
			"step": "wp-cli",
			"command": "wp plugin activate prc-block-library"
		},
		{
			"step": "wp-cli",
			"command": "wp plugin activate prc-taxonomies"
		},
		{
			"step": "wp-cli",
			"command": "wp plugin activate prc-icon-library"
		},
		{
			"step": "wp-cli",
			"command": "wp plugin activate prc-schema-seo"
		},
		{
			"step": "wp-cli",
			"command": "wp theme activate prc-design-system"
		},
		{
			"step": "wp-cli",
			"command": "wp rewrite flush"
		}
	]
}
